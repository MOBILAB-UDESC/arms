<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:arg name="gripper_joint_limits" default="$(find d1_2f_description)/config/joint_limits.yaml" />
    <xacro:arg name="gripper_initial_position" default="$(find d1_2f_description)/config/initial_position.yaml" />

    <xacro:property name="gripper_joint_limits_config" value="${xacro.load_yaml('$(arg gripper_joint_limits)')}" />
    <xacro:property name="gripper_positions_config" value="${xacro.load_yaml('$(arg gripper_initial_position)')}" />

    <!-- Position limits -->
    <xacro:property name="min_left_finger_joint_pos" value="${gripper_joint_limits_config['joint_limits']['joint_L']['min_position']}" />
    <xacro:property name="min_right_finger_joint_pos" value="${gripper_joint_limits_config['joint_limits']['joint_R']['min_position']}" />
    <xacro:property name="max_left_finger_joint_pos" value="${gripper_joint_limits_config['joint_limits']['joint_L']['max_position']}" />
    <xacro:property name="max_right_finger_joint_pos" value="${gripper_joint_limits_config['joint_limits']['joint_R']['max_position']}" />

    <!-- Velocity limits -->
    <xacro:property name="left_finger_joint_vel" value="${gripper_joint_limits_config['joint_limits']['joint_L']['max_velocity']}" />
    <xacro:property name="right_finger_joint_vel" value="${gripper_joint_limits_config['joint_limits']['joint_R']['max_velocity']}" />

    <!-- Effort limits -->
    <xacro:property name="left_finger_joint_effort" value="${gripper_joint_limits_config['joint_limits']['joint_L']['max_effort']}" />
    <xacro:property name="right_finger_joint_effort" value="${gripper_joint_limits_config['joint_limits']['joint_R']['max_effort']}" />

    <!-- Damping and friction -->
    <xacro:property name="left_finger_joint_damping" value="${gripper_joint_limits_config['joint_limits']['joint_L']['damping']}" />
    <xacro:property name="right_finger_joint_damping" value="${gripper_joint_limits_config['joint_limits']['joint_R']['damping']}" />
    <xacro:property name="left_finger_joint_friction" value="${gripper_joint_limits_config['joint_limits']['joint_L']['friction']}" />
    <xacro:property name="right_finger_joint_friction" value="${gripper_joint_limits_config['joint_limits']['joint_R']['friction']}" />

    <!-- Access initial positions -->
    <xacro:property name="left_finger_joint_initial" value="${gripper_positions_config['initial_positions']['joint_L']}" />
    <xacro:property name="right_finger_joint_initial" value="${gripper_positions_config['initial_positions']['joint_R']}" />

    <xacro:property name="material_black">
        <material name="black">
            <color rgba="0.1 0.1 0.1 1"/>
        </material>
    </xacro:property>

    <xacro:property name="material_dark_grey">
        <material name="dark_grey">
            <color rgba="0.3 0.3 0.3 1"/>
        </material>
    </xacro:property>

</robot>